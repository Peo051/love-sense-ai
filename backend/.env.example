# Backend local development.
# Production must set APP_ENV=production, FRONTEND_URL, DATABASE_URL, SECRET_KEY and LLM settings in the hosting secret manager.
APP_ENV=development
FRONTEND_URL=http://localhost:3000
# Local dev fallback. Backend tự tạo bảng khi dùng SQLite trong APP_ENV=development.
DATABASE_URL=sqlite+aiosqlite:///./love_emotion_dev.db
DATABASE_AUTO_CREATE=true
# PostgreSQL/Supabase example:
# DATABASE_URL=postgresql://user:password@localhost:5432/loveemotion
AI_SERVICE_URL=http://localhost:8001
LLM_PROVIDER=9router
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=api_models_all
LLM_MOCK_MODE=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.25
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
SECRET_KEY=change-this-for-local-dev
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
