# Public frontend config. Do not put backend secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Production Vercel:
# NEXT_PUBLIC_API_BASE_URL=https://love-sense-ai.onrender.com
# NEXT_PUBLIC_API_URL=https://love-sense-ai.onrender.com

# Firebase Web SDK config. These values are public Firebase client identifiers.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
